{
  "name": "claude-account-guard",
  "displayName": "Claude Account Guard",
  "description": "Give each VS Code workspace its own Claude Code account, see which one is in play, and inspect locally collected usage.",
  "version": "0.1.0",
  "type": "module",
  "publisher": "ResonanceLattice-Semanticus",
  "license": "MIT",
  "private": true,
  "os": [
    "win32"
  ],
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "accounts",
    "security",
    "usage",
    "telemetry"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "files": [
    "dist/**",
    "bin/**",
    "resources/**",
    "docs/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeAccountGuard.openMenu",
        "category": "Claude Account Guard",
        "title": "Account Menu",
        "icon": "$(account)"
      },
      {
        "command": "claudeAccountGuard.lockWorkspace",
        "category": "Claude Account Guard",
        "title": "Use a Claude Account in This Workspace"
      },
      {
        "command": "claudeAccountGuard.unlockWorkspace",
        "category": "Claude Account Guard",
        "title": "Use the Default Claude Account in This Workspace"
      },
      {
        "command": "claudeAccountGuard.switchProfile",
        "category": "Claude Account Guard",
        "title": "Change This Workspace's Claude Account"
      },
      {
        "command": "claudeAccountGuard.addProfile",
        "category": "Claude Account Guard",
        "title": "Add a Claude Account"
      },
      {
        "command": "claudeAccountGuard.login",
        "category": "Claude Account Guard",
        "title": "Sign In to This Workspace's Claude Account"
      },
      {
        "command": "claudeAccountGuard.verifyAccount",
        "category": "Claude Account Guard",
        "title": "Check This Workspace's Claude Identity"
      },
      {
        "command": "claudeAccountGuard.updateExpectedIdentity",
        "category": "Claude Account Guard",
        "title": "Update This Workspace's Expected Claude Identity"
      },
      {
        "command": "claudeAccountGuard.openDashboard",
        "category": "Claude Account Guard",
        "title": "Usage Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "claudeAccountGuard.configureWrapper",
        "category": "Claude Account Guard",
        "title": "Connect to Claude Code"
      },
      {
        "command": "claudeAccountGuard.disableWrapper",
        "category": "Claude Account Guard",
        "title": "Disconnect From Claude Code"
      },
      {
        "command": "claudeAccountGuard.removeAllData",
        "category": "Claude Account Guard",
        "title": "Remove All Account Guard Data"
      },
      {
        "command": "claudeAccountGuard.diagnostics",
        "category": "Claude Account Guard",
        "title": "Show Diagnostics"
      },
      {
        "command": "claudeAccountGuard.registerCurrentProfile",
        "category": "Claude Account Guard",
        "title": "Track the Default Claude Account"
      },
      {
        "command": "claudeAccountGuard.bindTerminal",
        "category": "Claude Account Guard",
        "title": "Use This Workspace's Account in Its Terminals"
      },
      {
        "command": "claudeAccountGuard.enableUsageCollection",
        "category": "Claude Account Guard",
        "title": "Collect Usage for This Workspace's Account"
      },
      {
        "command": "claudeAccountGuard.manageProfiles",
        "category": "Claude Account Guard",
        "title": "Manage Claude Accounts"
      },
      {
        "command": "claudeAccountGuard.exportUsage",
        "category": "Claude Account Guard",
        "title": "Export Local Usage"
      },
      {
        "command": "claudeAccountGuard.deleteUsageData",
        "category": "Claude Account Guard",
        "title": "Delete Local Usage Data"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeAccountGuard.updateExpectedIdentity",
          "when": "claudeAccountGuard.hasProfiles"
        },
        {
          "command": "claudeAccountGuard.lockWorkspace",
          "when": "workspaceFolderCount > 0 && !claudeAccountGuard.locked"
        },
        {
          "command": "claudeAccountGuard.unlockWorkspace",
          "when": "workspaceFolderCount > 0 && claudeAccountGuard.locked"
        },
        {
          "command": "claudeAccountGuard.switchProfile",
          "when": "workspaceFolderCount > 0 && claudeAccountGuard.locked"
        },
        {
          "command": "claudeAccountGuard.login",
          "when": "claudeAccountGuard.hasProfiles"
        },
        {
          "command": "claudeAccountGuard.verifyAccount",
          "when": "claudeAccountGuard.hasProfiles"
        },
        {
          "command": "claudeAccountGuard.configureWrapper",
          "when": "!claudeAccountGuard.wrapperConfigured"
        },
        {
          "command": "claudeAccountGuard.registerCurrentProfile",
          "when": "false"
        },
        {
          "command": "claudeAccountGuard.bindTerminal",
          "when": "false"
        },
        {
          "command": "claudeAccountGuard.enableUsageCollection",
          "when": "false"
        },
        {
          "command": "claudeAccountGuard.manageProfiles",
          "when": "false"
        },
        {
          "command": "claudeAccountGuard.exportUsage",
          "when": "false"
        },
        {
          "command": "claudeAccountGuard.deleteUsageData",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Account Guard",
      "properties": {
        "claudeAccountGuard.defaultLockMode": {
          "type": "string",
          "enum": [
            "enforce",
            "warn",
            "off"
          ],
          "default": "enforce",
          "description": "How a workspace's Claude account is applied. \"enforce\": set the account and stop the launch if the identity inside it does not match the one you confirmed. \"warn\": set the account and only report a mismatch. \"off\": record the choice without applying it."
        },
        "claudeAccountGuard.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Collect privacy-minimized Claude Code OpenTelemetry and status snapshots locally."
        },
        "claudeAccountGuard.telemetry.retentionDays": {
          "type": "number",
          "minimum": 1,
          "maximum": 365,
          "default": 30,
          "description": "Days to retain normalized event-level local usage."
        },
        "claudeAccountGuard.usage.warningThreshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 99,
          "default": 70,
          "description": "Local usage warning threshold. This is not an Anthropic policy threshold."
        },
        "claudeAccountGuard.usage.criticalThreshold": {
          "type": "number",
          "minimum": 2,
          "maximum": 100,
          "default": 90,
          "description": "Local usage critical threshold. This is not an Anthropic policy threshold."
        },
        "claudeAccountGuard.context.warningThreshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Local context-window warning threshold."
        },
        "claudeAccountGuard.statusBar.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "Show a fresh five-hour or more-severe seven-day percentage in the status bar."
        },
        "claudeAccountGuard.dashboard.defaultRange": {
          "type": "string",
          "enum": [
            "24h",
            "7d",
            "30d"
          ],
          "default": "7d",
          "description": "Default dashboard time range."
        },
        "claudeAccountGuard.privacy.collectWorkspacePath": {
          "type": "boolean",
          "default": false,
          "description": "Store full workspace paths in local telemetry. Disabled by default; labels and hashes are used otherwise."
        },
        "claudeAccountGuard.wrapper.autoConfigure": {
          "type": "boolean",
          "default": true,
          "description": "Allow Account Guard to set the global claudeCode.claudeProcessWrapper setting, after asking you once. This is what applies a per-workspace Claude account and collects token usage, so per-workspace accounts do nothing while it is off. To undo an existing change, run \"Claude Account Guard: Disconnect From Claude Code\"."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:collector": "node --experimental-transform-types --experimental-loader ./scripts/typescript-loader.mjs scripts/smoke-collector.ts",
    "smoke:core": "node --experimental-transform-types --experimental-loader ./scripts/typescript-loader.mjs scripts/smoke-core.ts",
    "smoke:registry": "node --experimental-transform-types --experimental-loader ./scripts/typescript-loader.mjs scripts/smoke-registry.ts",
    "smoke:repository": "node --experimental-transform-types --experimental-loader ./scripts/typescript-loader.mjs scripts/smoke-repository.ts",
    "smoke:statusline": "node scripts/smoke-statusline.mjs",
    "smoke:wrapper": "node scripts/smoke-wrapper.mjs",
    "smoke:wrapper:args": "node scripts/smoke-wrapper-args.mjs",
    "test:e2e": "npm run build && npm run smoke:runtime && npm run smoke:core && npm run smoke:registry && npm run smoke:repository && npm run smoke:collector && npm run smoke:statusline && npm run smoke:wrapper && npm run smoke:wrapper:args",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "package": "node scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.6.0",
    "@eslint/js": "~9.39.5",
    "eslint": "~9.39.5",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "~8.65.0",
    "vitest": "^3.2.4"
  }
}
